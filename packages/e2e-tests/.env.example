# Copy to a local, gitignored .env for a manual run, or set as encrypted
# GitHub Environment secrets ("production-qa") for CI — never commit real
# values. See README.md for how each of these is used and gated in code
# (src/config.ts).
#
# This suite never uses a Supabase service-role key or any direct database
# client — every value below is either a plain config string or a real
# login credential for a dedicated, fixed E2E test account. There is no
# SUPABASE_SERVICE_ROLE_KEY variable anywhere in this package.

# ---- Target environment -----------------------------------------------
# The confirmed Production URL. Never guessed/defaulted — the suite refuses
# to start without this set explicitly.
E2E_BASE_URL=

# Set to exactly "true" ONLY once mutation on the dedicated test accounts
# has been explicitly authorized for this run. Every mutating spec skips
# itself unless this is "true". Read-only specs run regardless.
E2E_BACKUP_CONFIRMED=

# Optional. If unset, a run ID is generated once per `playwright test`
# invocation as E2E-YYYYMMDD-HHMMSS (UTC). The mutating CI workflow computes
# this ONCE and passes the same value to every job (baseline, read-only,
# mutating, reconciliation) so they all tag the same run.
E2E_RUN_ID=

# ---- Dedicated test accounts (required roles) --------------------------
# Each must be a real Production account created specifically for testing,
# distinguishable from real users, with the role already assigned. Never the
# credentials of a real employee/admin.
E2E_EMPLOYEE_EMAIL=
E2E_EMPLOYEE_PASSWORD=

E2E_MANAGER_EMAIL=
E2E_MANAGER_PASSWORD=

# Note the prefix is "HR", not "HR_ADMIN" — matches this environment's
# actual "HR Test" account naming.
E2E_HR_EMAIL=
E2E_HR_PASSWORD=

E2E_CEO_EMAIL=
E2E_CEO_PASSWORD=

# ---- Optional test accounts ----------------------------------------------
# Leave blank if a dedicated account hasn't been confirmed to exist yet —
# specs needing it skip themselves cleanly.
E2E_FINANCE_EMAIL=
E2E_FINANCE_PASSWORD=

# Sys Admin ("Admin Test") — distinct from HR Admin above. Required for the
# account-status (deactivate/reactivate) mutating spec; that spec skips
# cleanly if this isn't configured, it never substitutes another role.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
