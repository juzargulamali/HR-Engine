# Copy to a local, gitignored .env (or export as encrypted CI secrets — never
# commit real values). See README.md for how each of these is used and
# gated in code (src/config.ts).

# ---- Target environment -----------------------------------------------
# The confirmed Production URL. Never guessed/defaulted — the suite refuses
# to start without this set explicitly.
E2E_BASE_URL=

# Set to exactly "true" only after a recoverable Supabase backup has been
# confirmed. Mutating specs skip themselves unless this is "true".
E2E_BACKUP_CONFIRMED=

# Optional. If unset, a run ID is generated once per run as E2E-YYYYMMDD-HHMM
# (UTC). Set this to reuse the same tag across multiple invocations of the
# same logical run (e.g. re-running one failed spec).
E2E_RUN_ID=

# Set to exactly "true" ONLY in a Claude cloud/container environment where
# Chromium's own certificate verifier is confirmed broken (see README.md's
# "Browser TLS validation bypass" section) — never as a general workaround.
# Never true by default, and never inferred automatically. When true,
# globalSetup independently re-verifies the real certificates with Node's
# own TLS stack (rejectUnauthorized: true) and aborts the whole run if that
# fails, so this can't hide a genuine certificate problem.
E2E_ALLOW_BROWSER_TLS_BYPASS=

# ---- Dedicated test accounts (required roles) --------------------------
# Each must be a real Production account created specifically for testing,
# distinguishable from real users, with the role already assigned. Never the
# credentials of a real employee/admin.
E2E_EMPLOYEE_EMAIL=
E2E_EMPLOYEE_PASSWORD=

E2E_MANAGER_EMAIL=
E2E_MANAGER_PASSWORD=

# Note the prefix is "HR", not "HR_ADMIN" — matches this environment's
# actual "HR Test" account naming.
E2E_HR_EMAIL=
E2E_HR_PASSWORD=

E2E_CEO_EMAIL=
E2E_CEO_PASSWORD=

# ---- Optional test accounts ----------------------------------------------
# Leave blank if a dedicated account hasn't been confirmed to exist yet —
# specs needing it skip themselves cleanly.
E2E_FINANCE_EMAIL=
E2E_FINANCE_PASSWORD=

# Sys Admin ("Admin Test") — distinct from HR Admin above.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# ---- Cleanup script only (scripts/dry-run-cleanup.ts) --------------------
# Service-role key: read-only usage in this script (queries only, never
# deletes/mutates). Never reused by the Playwright suite itself. Do NOT set
# this in an environment without a separate encrypted-secrets mechanism —
# it must never sit in a plaintext-visible environment variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
