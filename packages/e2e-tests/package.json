{
  "name": "@enginious-hr/e2e-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:read-only": "playwright test --grep-invert @mutating",
    "test:e2e:ui": "playwright test --ui",
    "cleanup:dry-run": "tsx scripts/dry-run-cleanup.ts",
    "redact:error-context": "tsx scripts/redact-error-context.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@supabase/supabase-js": "^2.47.0",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
