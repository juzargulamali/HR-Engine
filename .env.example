# apps/web reads these. Copy to apps/web/.env.local for local development
# (never commit a real .env.local — it's gitignored).

# Safe for the browser bundle — RLS is what actually protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Your deployed app's own URL, no trailing slash (e.g.
# https://hr-engine.vercel.app). Used to build the invite-email redirect
# link (lib/actions/users.ts) so it sends people to your live site, not
# localhost. Must also be added to the Supabase project's Authentication ->
# URL Configuration -> Redirect URLs allow-list, or Supabase will silently
# ignore it and fall back to the dashboard's Site URL instead.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# SERVER-ONLY. Never imported by any client component or route that ships to
# the browser. Used only inside Server Actions/Route Handlers that need to
# perform an operation RLS cannot express (e.g. provisioning a new auth user).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local Postgres connection string used only by the RLS test harness
# (packages/rls-tests) — never used by the running application.
RLS_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# SERVER-ONLY. Shared secret Vercel Cron sends as `Authorization: Bearer
# <value>` when calling /api/cron/* (see vercel.json) — generate a random
# string and set it in the Vercel project's env too. Without it, the cron
# routes reject every request (they refuse to run with no secret configured).
CRON_SECRET=generate-a-random-secret-and-set-it-in-vercel-too

# SERVER-ONLY. Bearer secret for /api/ai/detect-balance-discrepancies — the
# one endpoint an AI integration's own service identity calls (never a
# human session). Separate from CRON_SECRET on purpose: this identity is
# conceptually different from Vercel's own scheduler, even though Vercel
# Cron is what triggers it in this deployment (see vercel.json). This
# endpoint's own code has no path to write anywhere but `ai_drafts` —
# see docs/05-automation-rules.md §5.4.
AI_SERVICE_SECRET=generate-a-different-random-secret-and-set-it-in-vercel-too
