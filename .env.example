# apps/web reads these. Copy to apps/web/.env.local for local development
# (never commit a real .env.local — it's gitignored).

# Safe for the browser bundle — RLS is what actually protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Your deployed app's own URL, no trailing slash (e.g.
# https://hr-engine.vercel.app). Used to build the invite-email redirect
# link (lib/actions/users.ts) so it sends people to your live site, not
# localhost. Must also be added to the Supabase project's Authentication ->
# URL Configuration -> Redirect URLs allow-list, or Supabase will silently
# ignore it and fall back to the dashboard's Site URL instead.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# SERVER-ONLY. Never imported by any client component or route that ships to
# the browser. Used only inside Server Actions/Route Handlers that need to
# perform an operation RLS cannot express (e.g. provisioning a new auth user).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local Postgres connection string used only by the RLS test harness
# (packages/rls-tests) — never used by the running application.
RLS_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# SERVER-ONLY. Shared secret Vercel Cron sends as `Authorization: Bearer
# <value>` when calling /api/cron/* and /api/ai/detect-balance-discrepancies
# (see vercel.json) — generate a random string and set it in the Vercel
# project's env too. Without it, every one of these routes rejects every
# request (they refuse to run with no secret configured).
CRON_SECRET=generate-a-random-secret-and-set-it-in-vercel-too

# SERVER-ONLY. Microsoft Graph app registration (Azure AD / Entra) used to
# send leave-request notification emails "as" the actual employee/approver
# mailbox that triggered them (lib/email/graph.ts, lib/email/leave-
# notifications.ts) — client-credentials flow, so no per-user sign-in is
# needed. The app registration needs the *Application* permission Mail.Send
# with admin consent granted in your Microsoft 365 tenant. Leave unset and
# the notification calls just no-op (logged, never block the leave request
# itself) — nothing else in the app depends on these.
MICROSOFT_TENANT_ID=your-azure-ad-tenant-id
MICROSOFT_CLIENT_ID=your-app-registration-client-id
MICROSOFT_CLIENT_SECRET=your-app-registration-client-secret

# SERVER-ONLY. Jibble time-tracking import (lib/jibble/client.ts,
# /api/cron/jibble-sync, /api/cron/jibble-preview) — NOT wired into
# vercel.json's cron schedule yet; both routes exist only to be hit by hand
# (same CRON_SECRET Bearer auth as every other /api/cron/* route) until a
# real tenant has confirmed field names via jibble-preview. Two independent
# auth paths exist — set ONE, not both:
#   - JIBBLE_API_TOKEN: a Personal Access Token from Jibble's own
#     Organization Settings > API Keys. Simpler, self-serve, tried FIRST if set.
#   - JIBBLE_CLIENT_ID / JIBBLE_CLIENT_SECRET: an OAuth2 client_credentials
#     app (used only as a fallback if no JIBBLE_API_TOKEN is set).
# Neither has been confirmed against a real Jibble tenant from this
# environment — see client.ts's own header comment for exactly what remains
# unverified. JIBBLE_TOKEN_URL/JIBBLE_TIME_ENTRIES_URL override the
# (unconfirmed) default hosts if your tenant's differ.
JIBBLE_API_TOKEN=your-jibble-personal-access-token
# JIBBLE_CLIENT_ID=your-jibble-oauth-client-id
# JIBBLE_CLIENT_SECRET=your-jibble-oauth-client-secret
# JIBBLE_TOKEN_URL=https://identity.prod.jibble.io/connect/token
# JIBBLE_TIME_ENTRIES_URL=https://workspace.prod.jibble.io/v1/TimeEntries

# This is HR ENGINE's OWN internal companies.id (see /admin/companies) that
# imported Jibble entries should be attributed to — NOT a Jibble-side
# organization/workspace identifier. Required by /api/cron/jibble-sync;
# not read by /api/cron/jibble-preview (which never writes anything).
HR_ENGINE_TARGET_COMPANY_ID=uuid-of-the-company-row-jibble-entries-belong-to

# Only set this to "true" AFTER confirming via a real jibble-preview run
# that this tenant's TimeEntries records with no breaks-like field really
# do mean "no break was taken" (as opposed to breaks being modeled as
# separate sibling entries, or a duration that already nets breaks out).
# Until set, an entry with no recognized breaks field is flagged
# needs_review rather than trusted as a confirmed zero.
# JIBBLE_BREAKS_ABSENT_MEANS_ZERO=true
